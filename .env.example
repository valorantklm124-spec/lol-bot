# ── Riot API ─────────────────────────────────────────────────────────────
# https://developer.riotgames.com → Register Product
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Joueur tracké par défaut au 1er lancement (optionnel, sinon /track en jeu)
RIOT_GAME_NAME=jnr18k
RIOT_TAG_LINE=kzk

# Plateforme : euw1 na1 kr eun1 br1 tr1 ru jp1 la1 la2 oc1 ph2 sg2 th2 tw2 vn2
PLATFORM=euw1
# Routing régional : europe americas asia sea
REGION=europe

# ── Discord ──────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=
# ID du channel où poster les games (clic droit → Copier l'ID)
DISCORD_CHANNEL_ID=
# ID du serveur (optionnel) → slash commands dispo instantanément au lieu d'~1h
DISCORD_GUILD_ID=

# ── Anthropic ────────────────────────────────────────────────────────────
# MODE 1 — API officielle :
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_BASE_URL=        (vide)
#   ANTHROPIC_AUTH_TOKEN=      (vide)
# MODE 2 — Gateway custom (ex: myrellms) :
#   ANTHROPIC_BASE_URL=https://myrellms.xyz
#   ANTHROPIC_AUTH_TOKEN=myre-...
#   ANTHROPIC_API_KEY=         (vide)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Polling ──────────────────────────────────────────────────────────────
# Intervalle global de vérification (en-game + matchs) — secondes
POLL_SECONDS=60
